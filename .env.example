# ============================================================
#  Donation site — environment variables
#  Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

NODE_ENV=production
PORT=3000
# Public address of the site (https in production)
BASE_URL=https://donate.example.org

# ---- PayPal ----
# sandbox = test payments, live = real money
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created with: npm run paypal:webhook   (or in the PayPal developer dashboard)
PAYPAL_WEBHOOK_ID=
# Optional: name shown on the PayPal checkout page
PAYPAL_BRAND_NAME=
# Monthly donations (PayPal Subscriptions). Set to false to hide.
ENABLE_MONTHLY=true
CURRENCY=USD

# ---- Admin ----
ADMIN_USERNAME=admin
# Created with: npm run admin:password
ADMIN_PASSWORD_HASH=
# Random 64-char string (also printed by npm run admin:password)
SESSION_SECRET=

# ---- Misc ----
TIMEZONE=Asia/Jerusalem
DATABASE_PATH=./data/donations.db
# Number of proxies in front of the app (1 for most hosts / nginx)
TRUST_PROXY=1
