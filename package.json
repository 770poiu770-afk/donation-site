{
  "name": "donation-site",
  "version": "1.0.0",
  "description": "Donation website with PayPal (one-time & monthly), admin dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-concurrency=1 test/server.test.js",
