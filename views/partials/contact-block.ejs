<div class="contact-grid">
  <div class="contact-info">
    <h2 class="section-title reveal"><%= t('contact.title') %></h2>
    <p class="lead reveal"><%= t('contact.lead') %></p>
    <ul class="contact-list">
      <% if (org.email) { %><li class="reveal"><%- include('icon', { name: 'mail', size: 20 }) %><a href="mailto:<%= org.email %>"><%= org.email %></a></li><% } %>
      <% if (org.phone) { %><li class="reveal"><%- include('icon', { name: 'phone', size: 20 }) %><a href="tel:<%= org.phone.replace(/[^+\d]/g, '') %>" dir="ltr"><%= org.phone %></a></li><% } %>
      <% if (org.whatsapp) { %><li class="reveal"><%- include('icon', { name: 'chat', size: 20 }) %><a href="https://wa.me/<%= org.whatsapp %>" rel="noopener" target="_blank"><%= t('contact.whatsapp') %></a></li><% } %>
      <% const addr = org.address && (org.address[lang] || org.address.en); if (addr) { %><li class="reveal"><%- include('icon', { name: 'pin', size: 20 }) %><span><%= addr %></span></li><% } %>
    </ul>
  </div>
  <form class="contact-form reveal" method="post" action="/contact">
    <% if (sent) { %><p class="form-ok" role="status"><%= t('contact.sent') %></p><% } %>
    <% if (error) { %><p class="form-err" role="alert"><%= t('contact.error') %></p><% } %>
    <div class="row2">
      <label><span><%= t('contact.name') %></span><input name="name" required maxlength="120" autocomplete="name" value="<%= form.name || '' %>"></label>
      <label><span><%= t('contact.email') %></span><input name="email" type="email" required maxlength="254" autocomplete="email" dir="ltr" value="<%= form.email || '' %>"></label>
    </div>
    <label><span><%= t('contact.subject') %></span><input name="subject" maxlength="200" value="<%= form.subject || '' %>"></label>
    <label><span><%= t('contact.message') %></span><textarea name="message" required rows="5" maxlength="5000"><%= form.message || '' %></textarea></label>
    <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
    <button class="btn btn-ink" type="submit"><%= t('contact.send') %></button>
  </form>
</div>
