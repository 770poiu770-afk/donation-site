<%
  const dc = donateConfig;
  const fmtPreset = (n) => '$' + n.toLocaleString('en-US');
%>
<form class="donate-card" data-donate novalidate
      data-config='<%- JSON.stringify(dc).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>'
      data-i18n='<%- JSON.stringify(t("donate")).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>'
      data-errors='<%- JSON.stringify(t("errors")).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>'>
  <div class="donate-head">
    <h2 class="donate-title"><%= t('donate.button') %></h2>
    <% if (dc.monthlyEnabled) { %>
    <div class="freq" role="radiogroup" aria-label="<%= t('donate.title') %>">
      <label class="freq-opt"><input type="radio" name="freq" value="one_time" checked><span><%= t('donate.oneTime') %></span></label>
      <label class="freq-opt"><input type="radio" name="freq" value="monthly"><span><%= t('donate.monthly') %></span></label>
      <span class="freq-glider" aria-hidden="true"></span>
    </div>
    <% } %>
  </div>

  <fieldset class="amounts">
    <legend class="sr-only"><%= t('donate.chooseAmount') %></legend>
    <div class="amount-grid">
      <% dc.presets.forEach((p, i) => { %>
      <label class="amount-opt">
        <input type="radio" name="preset" value="<%= p %>" <%= p === 36 ? 'checked' : '' %>>
        <span dir="ltr"><%= fmtPreset(p) %></span>
      </label>
      <% }) %>
    </div>
    <label class="custom-amount">
      <span class="sr-only"><%= t('donate.otherAmount') %></span>
      <span class="currency" aria-hidden="true">$</span>
      <input type="text" name="custom" inputmode="decimal" autocomplete="off" maxlength="12" dir="ltr"
             placeholder="<%= t('donate.otherPlaceholder') %>" aria-describedby="donate-error">
      <span class="custom-suffix" data-suffix hidden><%= t('donate.perMonth') %></span>
    </label>
  </fieldset>

  <p class="donate-summary" aria-live="polite">
    <span><%= t('donate.youGive') %></span>
    <strong dir="ltr" data-summary>$36</strong><span class="per" data-per hidden><%= t('donate.perMonth') %></span>
  </p>
  <p class="monthly-note" data-monthly-note hidden><%= t('donate.monthlyNote') %></p>

  <details class="optional">
    <summary><%= t('donate.optionalToggle') %></summary>
    <div class="optional-body">
      <p class="hint"><%= t('donate.optionalHint') %></p>
      <label><span><%= t('donate.name') %></span><input type="text" name="name" maxlength="120" autocomplete="name"></label>
      <label><span><%= t('donate.email') %></span><input type="email" name="email" maxlength="254" autocomplete="email" dir="ltr"></label>
      <label><span><%= t('donate.message') %></span><textarea name="message" maxlength="1000" rows="2"></textarea></label>
    </div>
  </details>

  <div class="pay-area">
    <div class="pp-buttons" data-pp="one_time" aria-label="<%= t('donate.chooseMethod') %>"></div>
    <div class="pp-buttons" data-pp="monthly" hidden aria-label="<%= t('donate.chooseMethod') %>"></div>
    <div class="pp-loading" data-pp-loading><span class="spinner" aria-hidden="true"></span><%= t('donate.loadingPayPal') %></div>
  </div>

  <p class="donate-msg" id="donate-error" role="alert" data-msg hidden></p>
  <div class="processing" data-processing hidden><span class="spinner" aria-hidden="true"></span><%= t('donate.processing') %></div>

  <p class="secure-note">
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17 9V7a5 5 0 0 0-10 0v2H5v13h14V9h-2Zm-8-2a3 3 0 0 1 6 0v2H9V7Zm4 10.7V19h-2v-1.3a2 2 0 1 1 2 0Z"/></svg>
    <%= t('donate.secureNote') %>
  </p>
  <noscript><p class="donate-msg">JavaScript is required for secure PayPal checkout.</p></noscript>
</form>
<script src="/static/js/donate.js?v=<%= assetVersion %>" defer></script>
