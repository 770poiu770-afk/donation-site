<div class="tbl-wrap">
<table class="tbl">
  <thead><tr><th>תאריך ושעה</th><th>תורם</th><th>סכום</th><th>סוג</th><th>סטטוס</th><th>מספר עסקה PayPal</th></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="6" class="empty">אין תרומות להצגה.</td></tr><% } %>
  <% rows.forEach(r => {
       const name = r.payer_name || r.donor_name;
       const email = r.payer_email || r.donor_email; %>
    <tr class="clickable" data-href="/admin/donations/<%= r.id %>">
      <td><%= fmtDate(r.completed_at || r.created_at) %></td>
      <td><a href="/admin/donations/<%= r.id %>"><%= name || 'אנונימי' %></a><% if (email) { %><div class="sub" dir="ltr"><%= email %></div><% } %></td>
      <td><strong dir="ltr"><%= money(r.amount_cents, r.currency) %></strong><% if (r.refunded_cents) { %><div class="sub">הוחזר <%= money(r.refunded_cents, r.currency) %></div><% } %></td>
      <td><%= r.type === 'monthly' ? 'חודשית' : 'חד-פעמית' %></td>
      <td><span class="badge b-<%= r.status %>"><%= statusLabel[r.status] || r.status %></span></td>
      <td dir="ltr" class="mono ta-r"><%= r.paypal_capture_id || r.paypal_order_id || '—' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
